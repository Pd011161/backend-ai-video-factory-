FRONTEND_ORIGIN=

# Database PASSWORD only. Host, port, user, name and the sqlite-vs-postgres switch are non-secret
# and live in config.yaml under `database:`. Write the password plainly here even if it contains
# @ : / % — it is percent-encoded when the URL is assembled, so no manual escaping.
DB_PASSWORD=

# Optional escape hatch: a complete URL that overrides the whole `database:` block. docker-compose
# and CI use it because handing over one string beats mounting a config.yaml.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dbname
#
# Bringing existing SQLite data across after switching config.yaml to backend: postgres —
#   alembic upgrade head
#   python scripts/sqlite_to_postgres.py --source sqlite:///./app.db --target <postgres-url>

# Langfuse — secrets only. Non-secret settings (host, enabled, ...) live in config.yaml.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: overrides langfuse.host in config.yaml
# LANGFUSE_HOST=https://langfuse.kao9.dev

# Tavily — image search per scene. Sign up: https://app.tavily.com/
TAVILY_API_KEY=

# Gemini - image generate
GEMINI_API_KEY=


OPENAI_API_KEY=


AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET=
AWS_URL=
